# Backend REST API endpoint URL (deployment-only, defaults to http://localhost:8000 if unset)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Realtime WebSocket stream URL (deployment-only, defaults to ws://localhost:8000/ws/stream if unset)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream

# Shared secret header for mutating /demo/* routes (deployment-only, skipped if unset)
NEXT_PUBLIC_DEMO_SECRET=
