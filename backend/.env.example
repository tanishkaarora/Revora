# Razorpay (test mode only)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# LLM provider: "ollama" (default, local, zero cost) | "gemini" (free tier) | "groq" (free tier, cloud, fast)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Guardrail policy defaults
MAX_CONTACTS_PER_CASE=3
MIN_CONTACT_GAP_HOURS=12
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
REFUND_SIGNOFF_THRESHOLD_PAISE=500000

# Triage capacity (per simulated day)
CAPACITY_WHATSAPP=50
CAPACITY_HUMAN_CALL=5
FAIRNESS_FLOOR_SLOTS=10

# Server & Deployment (Deployment-only options; defaults to local if unset)
PORT=8000
BACKEND_PORT=8000
DATABASE_PATH=./data/recovery.db
# Allowed CORS origins (comma-separated for multiple, deployment-only)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Shared secret for mutating /demo/* endpoints (deployment-only, skipped if unset)
DEMO_SECRET=
